# ==============================================================================
# Repro Radar: Hardened Docker Sandbox for Isolated Execution
# Security Profile:
#   - Non-root user (sandboxuser: 1000:1000)
#   - Read-only root filesystem compatible
#   - Pre-baked core computational dependencies for offline evaluation (--network none)
# ==============================================================================

ARG PYTHON_VERSION=3.11
FROM python:${PYTHON_VERSION}-slim AS sandbox
ARG PYTHON_VERSION

# Prevent interactive prompts during installation
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONHASHSEED=42 \
    HOME=/workspace/home \
    PYTHONUSERBASE=/workspace/home/.local \
    PATH="/workspace/home/.local/bin:${PATH}" \
    PYTHONPATH="/workspace/repo:/workspace/home/.local/lib/python${PYTHON_VERSION}/site-packages:${PYTHONPATH}"

# Install essential execution dependencies & clean apt cache
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    coreutils \
    procps \
    bc \
    && rm -rf /var/lib/apt/lists/*

# Create unprivileged sandbox user and group
RUN groupadd -g 1000 sandboxgroup && \
    useradd -u 1000 -g sandboxgroup -m -s /bin/bash -d /workspace/home sandboxuser

# Pre-install baseline scientific runtime packages (for offline --network none execution)
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    "numpy>=1.24.0" \
    "scipy>=1.10.0" \
    "pandas>=2.0.0" \
    "scikit-learn>=1.3.0" \
    "tabulate>=0.9.0" \
    "pytest>=7.4.0"

# Prepare workspace directories and user local environment
WORKDIR /workspace/repo
RUN mkdir -p /workspace/repo /workspace/output /workspace/home/.local /workspace/packages && \
    chown -R sandboxuser:sandboxgroup /workspace

# Copy security entrypoint wrapper
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod 755 /entrypoint.sh

# Drop to non-root user
USER sandboxuser

ENTRYPOINT ["/entrypoint.sh"]
CMD ["python", "--version"]

# ------------------------------------------------------------------------------
# Build image (#193, `docker build --target build`): the sandbox plus a C/C++ compiler and the packaging tools,
# used only by the build phase (SANDBOX_PHASE=build), which turns sdists into wheels with the network off.
# Paper runs and the install phase keep using the default image above, which has no compiler.
# ------------------------------------------------------------------------------
FROM sandbox AS build
USER root
RUN apt-get update && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir setuptools wheel
USER sandboxuser

# The default target (no --target) stays the sandbox image without a compiler.
FROM sandbox AS default
